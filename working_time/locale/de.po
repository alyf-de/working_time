#: working_time/reminders.py:146
msgid ""
"Dear {first_name},\n"
"\n"
"You have a draft <a href='{url}'>working time entry</a> that is older than {cutoff_days} days. Please submit it as soon as possible.\n"
"\n"
"Thanks in advance!"
msgstr ""
"Hallo {first_name},\n"
"\n"
"du hast einen <a href='{url}'>Arbeitszeiteintrag</a> im Entwurf, der älter als {cutoff_days} Tage ist. Bitte reiche ihn so bald wie möglich ein.\n"
"\n"
"Vielen Dank!"

#: working_time/reminders.py:66
msgid ""
"Dear {first_name},\n"
"\n"
"{month} is almost over. Please remember to submit your <a href='{url}'>working time</a>.\n"
"\n"
"Thanks in advance!"
msgstr ""
"Hallo {first_name},\n"
"\n"
"der {month} ist fast vorbei. Bitte denke daran, deine <a href='{url}'>Arbeitszeit</a> einzureichen.\n"
"\n"
"Vielen Dank!"

